const originalDigest = crypto.subtle.digest.bind(crypto.subtle);
x = clone();
let mutated = false;
crypto.subtle.digest = async (...args) => {
  const result = await originalDigest(...args);
  if (!mutated) {
    mutated = true;
    e(x).history[0].reason = "changed during asynchronous source gate";
  }
  return result;
};
