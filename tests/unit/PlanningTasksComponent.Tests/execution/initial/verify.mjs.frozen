  a.history.push(h);
  a.revision = n;
  a.state = h.recordedState;
  a.canReview = a.state !== "ReviewedForPlanning";
  a.canWithdraw = !a.canReview;
  for (const opt of d(x).options) {
    for (const v of opt.currentAttestations)
