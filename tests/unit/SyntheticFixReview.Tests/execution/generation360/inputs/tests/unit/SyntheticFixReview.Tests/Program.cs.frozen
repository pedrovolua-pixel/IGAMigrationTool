using System.Collections.Immutable;
using System.Reflection;
using System.Security.Cryptography;
using System.Text;
using System.Text.Json;
using System.Text.Json.Nodes;
using System.Text.Json.Serialization;
using RecommendationGuidance;
using SyntheticFixPackages;
using SyntheticFixReview;

internal static class Program
{
    private static int checks;
    internal static readonly JsonSerializerOptions Options = new(JsonSerializerDefaults.Web) { Converters = { new JsonStringEnumConverter(allowIntegerValues: false) } };
    internal static void Check(bool value, string name) { checks++; if (!value) throw new InvalidOperationException("FAIL: " + name); }
    internal static string FixturePath = "";
    internal static string Hash(string value) => Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
    internal static string Canonical<T>(T value)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream)) Write(writer, JsonSerializer.SerializeToElement(value, Options));
        return Encoding.UTF8.GetString(stream.ToArray());
    }
    private static void Write(Utf8JsonWriter writer, JsonElement value)
    {
        if (value.ValueKind == JsonValueKind.Object) { writer.WriteStartObject(); foreach (var field in value.EnumerateObject().OrderBy(field => field.Name, StringComparer.Ordinal)) { writer.WritePropertyName(field.Name); Write(writer, field.Value); } writer.WriteEndObject(); }
        else if (value.ValueKind == JsonValueKind.Array) { writer.WriteStartArray(); foreach (var item in value.EnumerateArray()) Write(writer, item); writer.WriteEndArray(); }
        else value.WriteTo(writer);
    }
    internal static GuidanceInput Input()
    {
        var input = GuidanceFixture.Create(); var versions = JsonNode.Parse(input.Source.FrozenVersions.GetRawText())!.AsObject();
        versions["applicationVersion"] = "synthetic-fix-review-app-v1";
        versions["fixPackageTemplateDigest"] = "a40f3ccb1128581f36de236dbca3353097f4034b6738bcd01a98275229bee669";
        versions["fixReviewContractDigest"] = "a0dca320bcf11dda2f03abc16387f75395caff48e9c917c6b58a2826eb5a8b0f";
        return input with { Source = input.Source with { ProfileId = "synthetic-review-maturity-fix-review-equal-v1", FrozenVersions = JsonSerializer.SerializeToElement(versions) } };
    }
    internal static FixPackageSnapshot Package(GuidanceInput input)
    {
        var guidance = RecommendationGuidanceBuilder.Build(input); Check(guidance.Succeeded, "real guidance build");
        var package = FixPackageBuilder.Build(guidance.Snapshot); Check(package.Succeeded, "real package build"); return package.Snapshot!;
    }
    internal static ArtifactReviewAuthority Authority => new("synthetic-consultant", true, true, false, true, ArtifactReviewScope.Fixed,
        [ArtifactReviewRole.Consultant], ["SECURITY", "OPERATIONS"], [ArtifactReviewAction.Read, ArtifactReviewAction.Review], ArtifactReviewResourceState.Mutable);
    private static async Task Main(string[] args)
    {
        var path = new DirectoryInfo(AppContext.BaseDirectory);
        while (path is not null && !File.Exists(Path.Combine(path.FullName, "independent-oracle.py"))) path = path.Parent;
        FixturePath = path?.FullName ?? throw new InvalidOperationException("Independent oracles missing.");
        Check(ArtifactReviewSourceBuilder.ProfileId == "synthetic-review-maturity-fix-review-equal-v1" && ArtifactReviewSourceBuilder.ApplicationVersion == "synthetic-fix-review-app-v1", "literal dedicated profile/application");
        Check(ArtifactReviewSourceBuilder.ContractDigest == "a0dca320bcf11dda2f03abc16387f75395caff48e9c917c6b58a2826eb5a8b0f", "literal approved contract lock");
        foreach (var name in new[] { "normal", "empty", "multi", "hostile" })
        {
            var input = Input();
            if (name == "empty") input = input with { Findings = [] };
            if (name == "multi")
            {
                var first = input.Findings[0] with { Options = [.. input.Findings[0].Options, new("compare-fixture", "Compare fictional evidence.", "A separate fixture run.", "No closure claim.", "Retain originals.")],
                    Occurrences = [.. input.Findings[0].Occurrences, new(new string('f', 64), "OBJECT-2", "SyntheticControl", "SyntheticOperations", GuidanceFixture.Digest, "fixture-evidence:OBJECT-2")] };
                var second = input.Findings[0] with { FindingId = new string('d', 64), Occurrences = [new(new string('e', 64), "OBJECT-3", "SyntheticControl", "SyntheticSecurity", GuidanceFixture.Digest, "fixture-evidence:OBJECT-3")] };
                input = input with { Findings = [second, first] };
            }
            if (name == "hostile")
            {
                const string text = "<script>alert('x')</script> \0\r\né e\u0301 😀 \" + & ` =SUM(A1)\nhttps://invalid.example/evil";
                input = input with { Findings = [input.Findings[0] with { OriginalTitle = text, PresentationTitle = text, BusinessContext = text, Options = [input.Findings[0].Options[0] with { Text = text }] }] };
            }
            var package = Package(input); var source = ArtifactReviewSourceBuilder.Build(package);
            Check(source.Succeeded, name + " source succeeds");
            Check(package.CanonicalJson == File.ReadAllText(Path.Combine(FixturePath, name + "-golden.json")), name + " whole independently authored canonical package");
            Check(Canonical(source.Source!.Binding) == File.ReadAllText(Path.Combine(FixturePath, name + "-binding.json")), name + " complete independent source binding");
            Check(Canonical(source.Source.Artifacts) == File.ReadAllText(Path.Combine(FixturePath, name + "-artifacts.json")), name + " every independent identity/text digest/order");
            Check(source.Source.Artifacts.All(artifact => artifact.ArtifactTextDigest.Length == 64) && package.Packages.All(p => p.Options.All(o => o.Artifacts.All(a => a.Status == "Unverified"))), name + " originals unchanged");
            var before = package.CanonicalJson; ArtifactReviewSourceBuilder.Build(package); Check(package.CanonicalJson == before, name + " source build immutable");
            foreach (var property in new[] { "ContentDigest", "CanonicalJson", "TemplateDigest", "Status", "SchemaVersion", "Disclaimer", "TemplateVersion" })
            {
                var changed = Package(input); typeof(FixPackageSnapshot).GetField("<" + property + ">k__BackingField", BindingFlags.NonPublic | BindingFlags.Instance)!.SetValue(changed, "corrupt");
                var denied = ArtifactReviewSourceBuilder.Build(changed); Check(!denied.Succeeded && denied.Source is null, name + " fail closed " + property);
            }
        }
        void Mutate(FixPackageSnapshot package, string property, object value) => typeof(FixPackageSnapshot)
            .GetField("<" + property + ">k__BackingField", BindingFlags.NonPublic | BindingFlags.Instance)!.SetValue(package, value);
        foreach (var property in new[] { "Templates", "Packages", "Warnings", "UnavailableSections" })
        {
            var changed = Package(Input());
            if (property == "Templates") Mutate(changed, property, changed.Templates.Select((item, index) => index == 0 ? item with { Text = "forged" } : item).ToImmutableArray());
            if (property == "Packages") Mutate(changed, property, changed.Packages.Select(package => package with { Options = package.Options.Select(option => option with { Artifacts = option.Artifacts.Select(artifact => artifact with { Text = "forged", Kind = "Script" }).ToImmutableArray() }).ToImmutableArray() }).ToImmutableArray());
            if (property == "Warnings") Mutate(changed, property, changed.Warnings.Add("forged"));
            if (property == "UnavailableSections") Mutate(changed, property, changed.UnavailableSections.Add("forged"));
            var forgedCanonical = Canonical(new { changed.SchemaVersion, changed.Status, changed.Disclaimer, changed.Guidance, changed.TemplateVersion, changed.TemplateDigest, changed.Templates, changed.Packages, changed.Warnings, changed.UnavailableSections });
            Mutate(changed, "CanonicalJson", forgedCanonical); Mutate(changed, "ContentDigest", Hash(forgedCanonical));
            var rejected = ArtifactReviewSourceBuilder.Build(changed);
            Check(rejected.Issue == ArtifactReviewIssue.IntegrityMismatch && rejected.Source is null, "rehashing cannot bless mutated actual " + property);
        }
        var expanded = Package(Input()); Mutate(expanded, "Warnings", ImmutableArray.Create(new string('<', 6_000_000)));
        Check(ArtifactReviewSourceBuilder.Build(expanded).Issue == ArtifactReviewIssue.IntegrityMismatch, "escaped oversized actual property fails closed across internal exception boundary");
        Check(ArtifactReviewSourceBuilder.Build(null).Issue == ArtifactReviewIssue.SourceUnavailable, "missing source closed");
        Check(!ArtifactReviewSourceBuilder.Build(Package(GuidanceFixture.Create())).Succeeded, "historical real package source denied");
        var oversized = Input() with { Source = Input().Source with { RunRevision = 9007199254740992, ReviewRunRevision = 9007199254740992 } };
        Check(!ArtifactReviewSourceBuilder.Build(Package(oversized)).Succeeded, "HTTP unsafe run revision denied");
        var laterFinding = Input() with { Findings = [Input().Findings[0] with { FindingRevision = 9007199254740992 }] };
        Check(ArtifactReviewSourceBuilder.Build(Package(laterFinding)).Issue == ArtifactReviewIssue.RevisionOverflow, "HTTP unsafe finding revision denied");
        var packageNormal = Package(Input());
        foreach (var field in new[] { "applicationVersion", "fixReviewContractDigest", "fixPackageTemplateDigest", "profileVersion", "aiPolicyVersion", "promptVersion", "modelVersion", "workSchemaVersion", "analysisFixtureDigest" })
        {
            var input = Input(); var versions = JsonNode.Parse(input.Source.FrozenVersions.GetRawText())!.AsObject(); versions[field] = "wrong";
            Check(!RecommendationGuidanceBuilder.Build(input with { Source = input.Source with { FrozenVersions = JsonSerializer.SerializeToElement(versions) } }).Succeeded, "upstream exact frozen lock refuses " + field);
            versions.Remove(field); Check(!RecommendationGuidanceBuilder.Build(input with { Source = input.Source with { FrozenVersions = JsonSerializer.SerializeToElement(versions) } }).Succeeded, "upstream missing frozen lock refuses " + field);
        }
        foreach (var role in Enum.GetValues<ArtifactReviewRole>()) Check(ArtifactReviewPolicy.Authorize(Authority with { Roles = [role] }, ArtifactReviewScope.Fixed) == (role == ArtifactReviewRole.Consultant ? null : ArtifactReviewIssue.Denied), "sole role policy " + role);
        foreach (var role in Enum.GetValues<ArtifactReviewRole>()) Check(ArtifactReviewPolicy.Authorize(Authority with { Roles = [ArtifactReviewRole.Consultant, role] }, ArtifactReviewScope.Fixed) == ArtifactReviewIssue.Denied, "mixed/duplicate role policy " + role);
        foreach (var authority in new[] { Authority with { Authenticated = false }, Authority with { Active = false }, Authority with { Revoked = true }, Authority with { AssignmentActive = false }, Authority with { ActorId = "" }, Authority with { Roles = default }, Authority with { Actions = [] }, Authority with { Actions = [ArtifactReviewAction.Read] }, Authority with { Actions = [ArtifactReviewAction.Review] }, Authority with { Categories = [] }, Authority with { AssignedScope = ArtifactReviewScope.Fixed with { CustomerId = "foreign" } } }) Check(ArtifactReviewPolicy.Authorize(authority, ArtifactReviewScope.Fixed) == ArtifactReviewIssue.Denied, "identity/action denied");
        foreach (var state in Enum.GetValues<ArtifactReviewResourceState>()) Check(ArtifactReviewPolicy.Authorize(Authority with { ResourceState = state }, ArtifactReviewScope.Fixed) == (state == ArtifactReviewResourceState.Mutable ? null : ArtifactReviewIssue.Denied), "resource policy " + state);
        Check(ArtifactReviewPolicy.Authorize(Authority with { Categories = ["OPERATIONS"] }, ArtifactReviewScope.Fixed, "SECURITY") == ArtifactReviewIssue.Denied, "category denied");
        var command = new ArtifactReviewCommand(Guid.Parse("42daef99-443e-4bf3-ace2-b44e6e088207"), ArtifactReviewKind.ReviewForPlanning, 0, packageNormal.ContentDigest, "  preserve \0\r\n é e\u0301 😀  ");
        Check(ArtifactReviewPolicy.ValidateCommand(command) is null, "exact controls Unicode reason allowed");
        Check(ArtifactReviewPolicy.ValidateCommand(command with { Reason = new string('x', 2000) }) is null, "2000 UTF16 allowed");
        foreach (var changed in new[] { command with { EventId = Guid.Empty }, command with { Kind = (ArtifactReviewKind)999 }, command with { ExpectedRevision = -1 }, command with { ExpectedRevision = 9007199254740992 }, command with { ExpectedSourceDigest = "wrong" }, command with { Reason = " \r\n\t" }, command with { Reason = new string('x', 2001) }, command with { Reason = "\uD800" }, command with { Reason = "\uDC00" } }) Check(ArtifactReviewPolicy.ValidateCommand(changed) == ArtifactReviewIssue.InvalidInput, "invalid command bounded");
        foreach (var state in Enum.GetValues<ArtifactReviewState>()) foreach (var kind in Enum.GetValues<ArtifactReviewKind>()) Check(ArtifactReviewPolicy.Transition(state, kind) == ((kind == ArtifactReviewKind.ReviewForPlanning && state != ArtifactReviewState.ReviewedForPlanning || kind == ArtifactReviewKind.WithdrawReview && state == ArtifactReviewState.ReviewedForPlanning) ? null : ArtifactReviewIssue.InvalidState), "transition matrix " + state + kind);
        foreach (var connection in new[] { "Host=remote.example;Database=iga_synthetic_fake", "Host=127.0.0.1;Database=customer", "Host=127.0.0.1;Database=iga_synthetic_fake;Username=fake" })
        {
            if (connection.Contains("Username", StringComparison.Ordinal)) { _ = new SyntheticFixReviewStore(connection, ArtifactReviewScope.Fixed, (_, _) => Task.FromResult(new ArtifactReviewSourceResult(ArtifactReviewIssue.SourceUnavailable, null))); Check(true, "guarded synthetic constructor accepted without opening DB"); }
            else { try { _ = new SyntheticFixReviewStore(connection, ArtifactReviewScope.Fixed, (_, _) => Task.FromResult(new ArtifactReviewSourceResult(ArtifactReviewIssue.SourceUnavailable, null))); Check(false, "unsafe constructor"); } catch (ArgumentException) { Check(true, "unsafe DB refused"); } }
        }
        if (args.Contains("--database", StringComparer.Ordinal)) await DatabaseCases.Run();
        Console.WriteLine("PASS " + checks + " actual assertions" + (args.Contains("--database", StringComparer.Ordinal) ? " portable+owned PostgreSQL" : " portable (PostgreSQL not executed)"));
    }
}
