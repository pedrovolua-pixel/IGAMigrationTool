<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <CollectorSourcePagesProject Condition="'$(CollectorSourcePagesProject)' == ''">../../../src/collector/CollectorSourcePages/CollectorSourcePages.csproj</CollectorSourcePagesProject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(CollectorSourcePagesProject)" /></ItemGroup>
</Project>
