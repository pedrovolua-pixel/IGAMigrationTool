{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iga:private-local-demo:v1",
  "title": "Private synthetic local-demo DTOs \u2014 not a production HTTP contract",
  "$defs": {
    "RunState": {
      "enum": ["Planned", "Running", "Scoring", "Cancelled", "Failed"]
    },
    "CompletionKind": {
      "enum": ["Complete", "CompleteWithGaps"]
    },
    "CoverageState": {
      "enum": [
        "Pass",
        "Finding",
        "NotApplicable",
        "NotAssessed",
        "InsufficientEvidence",
        "Excluded",
        "Inaccessible",
        "Redacted",
        "Unsupported",
        "Error"
      ]
    },
    "ScopeOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["id", "label"]
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": ["code", "message"]
    },
    "BaselineOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        }
      },
      "required": ["id", "label", "scopeId", "version", "warnings"]
    },
    "ProfileOption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baselineIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": ["id", "label", "version", "baselineIds"]
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "demoOnly": {
          "const": true
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopeOption"
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BaselineOption"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProfileOption"
          }
        },
        "csrfToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "schemaVersion",
        "demoOnly",
        "scopes",
        "baselines",
        "profiles",
        "csrfToken"
      ]
    },
    "StartRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baselineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": ["scopeId", "baselineId", "profileId", "requestId"]
    },
    "RunMutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": ["expectedRevision", "requestId"]
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scopeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baselineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baselineLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profileLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scopeId",
        "scopeLabel",
        "baselineId",
        "baselineLabel",
        "profileId",
        "profileLabel"
      ]
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plannedUnits": {
          "type": "integer",
          "minimum": 0
        },
        "terminalUnits": {
          "type": "integer",
          "minimum": 0
        },
        "remainingUnits": {
          "type": "integer",
          "minimum": 0
        },
        "allTerminal": {
          "type": "boolean"
        }
      },
      "required": [
        "plannedUnits",
        "terminalUnits",
        "remainingUnits",
        "allTerminal"
      ]
    },
    "LockedInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["name", "version", "sha256"]
    },
    "StateCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/CoverageState"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["state", "count"]
    },
    "Limitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/CoverageState"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "responsibleStage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["state", "reasonCode", "responsibleStage", "count"]
    },
    "ExecutableCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "hasApplicableUnits": {
          "type": "boolean"
        }
      },
      "required": ["numerator", "denominator", "hasApplicableUnits"]
    },
    "RunActions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canCancel": {
          "type": "boolean"
        },
        "canResume": {
          "type": "boolean"
        },
        "resumeAvailableAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "canCancel",
        "canResume",
        "resumeAvailableAtUtc",
        "reasonCode"
      ]
    },
    "RunSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "coverageCompletionKind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancelRequested": {
          "type": "boolean"
        }
      },
      "required": [
        "runId",
        "revision",
        "state",
        "createdAtUtc",
        "updatedAtUtc",
        "selection",
        "progress",
        "coverageCompletionKind",
        "cancelRequested"
      ]
    },
    "RunDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "demoOnly": {
          "const": true
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "coverageCompletionKind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "lockedInputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockedInput"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        },
        "stateCounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateCount"
          }
        },
        "executableCoverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutableCoverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Limitation"
          }
        },
        "actions": {
          "$ref": "#/$defs/RunActions"
        },
        "cancelRequested": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "demoOnly",
        "runId",
        "revision",
        "state",
        "createdAtUtc",
        "updatedAtUtc",
        "selection",
        "progress",
        "coverageCompletionKind",
        "lockedInputs",
        "warnings",
        "stateCounts",
        "executableCoverage",
        "limitations",
        "actions",
        "cancelRequested"
      ]
    },
    "RunHistory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "demoOnly": {
          "const": true
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunSummary"
          }
        }
      },
      "required": ["schemaVersion", "demoOnly", "runs"]
    },
    "DemoError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "correlationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "currentRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message",
        "correlationId",
        "currentRevision"
      ]
    },
    "AnalysisScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["Unavailable", "Red", "Yellow", "Green"]
        },
        "eligibleUnits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["raw", "display", "status", "eligibleUnits"]
    },
    "AnalysisScoreRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "provisional": {
          "$ref": "#/$defs/AnalysisScore"
        },
        "publishableCurrent": {
          "$ref": "#/$defs/AnalysisScore"
        }
      },
      "required": ["id", "provisional", "publishableCurrent"]
    },
    "AnalysisCategoryRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "provisional": {
          "$ref": "#/$defs/AnalysisScore"
        },
        "publishableCurrent": {
          "$ref": "#/$defs/AnalysisScore"
        },
        "provisionalWeight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishableWeight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provisional",
        "publishableCurrent",
        "provisionalWeight",
        "publishableWeight"
      ]
    },
    "AnalysisFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "enum": ["Critical", "High", "Medium", "Low", "Informational"]
        },
        "confidencePercent": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "ruleId": {
          "type": "string"
        },
        "ruleVersion": {
          "type": "string"
        },
        "baselineId": {
          "type": "string"
        },
        "rootCauseKey": {
          "type": "string"
        },
        "objectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impact": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validationGuidance": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidenceBand": {
          "type": "string"
        },
        "method": {
          "const": "Deterministic"
        },
        "likelihood": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "originalDigests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rootCause": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "severity",
        "confidencePercent",
        "state",
        "reviewRequired",
        "ruleId",
        "ruleVersion",
        "baselineId",
        "rootCauseKey",
        "objectIds",
        "evidenceReferences",
        "facts",
        "inferences",
        "assumptions",
        "impact",
        "recommendations",
        "validationGuidance",
        "sources",
        "confidenceBand",
        "method",
        "likelihood",
        "limitations",
        "originalDigests",
        "outcomeIds",
        "rootCause"
      ]
    },
    "AnalysisQuality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plannedUnits": {
          "type": "integer",
          "minimum": 0
        },
        "executedUnits": {
          "type": "integer",
          "minimum": 0
        },
        "gapUnits": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicableUnits": {
          "type": "integer",
          "minimum": 0
        },
        "proposedReviewUnits": {
          "type": "integer",
          "minimum": 0
        },
        "totalFindingUnits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "plannedUnits",
        "executedUnits",
        "gapUnits",
        "notApplicableUnits",
        "proposedReviewUnits",
        "totalFindingUnits"
      ]
    },
    "AnalysisDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "demoOnly": {
          "const": true
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "runRevision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": ["Ready", "Unavailable"]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithmVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixtureDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provisional": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisScore"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishableCurrent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisScore"
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisCategoryRow"
          }
        },
        "objectTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisScoreRow"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisScoreRow"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisScoreRow"
          }
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisQuality"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisFinding"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "demoOnly",
        "runId",
        "runRevision",
        "status",
        "reasonCode",
        "algorithmVersion",
        "fixtureDigest",
        "contentDigest",
        "provisional",
        "publishableCurrent",
        "categories",
        "objectTypes",
        "modules",
        "outcomes",
        "quality",
        "findings",
        "warnings"
      ]
    }
  }
}
